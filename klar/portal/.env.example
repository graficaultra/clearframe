# Supabase project (create in EU region, e.g. Frankfurt)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service role key — server only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=...
# Random 32+ char secret for signing portal session cookies
PORTAL_SESSION_SECRET=change-me-to-a-long-random-string
